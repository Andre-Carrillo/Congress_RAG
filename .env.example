# Rutas del corpus incluido en el repositorio.
# CORPUS_DIR contiene los CSV consolidados y las actas en texto.
CORPUS_DIR=./data/corpus
LEGACY_DIR=./data/corpus/legacy
DATA_DIR=./data
DB_PATH=./data/processed/congress.db
CHROMA_DIR=./data/chroma
CHUNKS_PATH=./data/processed/chunks.jsonl
QA_REPORT_PATH=./data/processed/qa_report.csv

# Alcance: dos últimas legislaturas ordinarias
LEGISLATURAS=2025-2026-L1,2025-2026-L2

# LLM (ollama | gemini)
LLM_PROVIDER=ollama
# Router con LLM: gasta una llamada extra; las reglas ya detectan moción/proyecto.
LLM_ROUTER=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=45000

# Embeddings y recuperación
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=5
MIN_SCORE=0.25

# API HTTP
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=*

